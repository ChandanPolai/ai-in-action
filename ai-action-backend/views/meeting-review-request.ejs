<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Meeting Review</title>
</head>
<body style="font-family: Arial, sans-serif; background:#f8fafc; padding:24px;">
  <div style="max-width:560px;margin:0 auto;background:#fff;border-radius:12px;padding:28px;border:1px solid #e2e8f0;">
    <h2 style="color:#0f172a;margin:0 0 12px;">Hi <%= name %>,</h2>
    <p style="color:#475569;line-height:1.6;">
      Thank you for attending <strong><%= meetingTitle %></strong>.
    </p>
    <p style="color:#475569;line-height:1.6;">
      Please share a quick review for this meeting. Your feedback helps us improve.
    </p>
    <p style="margin:24px 0;">
      <a href="<%= reviewUrl %>" style="display:inline-block;background:#2563eb;color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:bold;">
        Give Review
      </a>
    </p>
    <p style="color:#94a3b8;font-size:12px;margin-top:24px;">AI in Action</p>
  </div>
</body>
</html>
