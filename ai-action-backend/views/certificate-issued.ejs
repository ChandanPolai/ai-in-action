<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Your Certificate</title>
</head>
<body style="font-family: Arial, sans-serif; background:#f8fafc; padding:24px;">
  <div style="max-width:560px;margin:0 auto;background:#fff;border-radius:12px;padding:28px;border:1px solid #e2e8f0;">
    <div style="text-align:center;margin-bottom:18px;">
      <img src="<%= logoUrl %>" alt="AI in Action" width="100" height="100" style="border-radius:14px;display:inline-block;" />
    </div>
    <h2 style="color:#0f172a;margin:0 0 12px;">Hi <%= name %>,</h2>
    <p style="color:#475569;line-height:1.6;">
      Your certificate for <strong><%= courseTitle %></strong> is ready.
    </p>
    <p style="color:#64748b;font-size:13px;line-height:1.5;">
      Certificate ID: <strong><%= certId %></strong><br />
      Issue date: <%= issueDate %>
    </p>
    <p style="margin:24px 0;text-align:center;">
      <a href="<%= pdfUrl %>" style="display:inline-block;background:#1e3a5f;color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:bold;">
        Download Certificate (PDF)
      </a>
    </p>
    <p style="color:#94a3b8;font-size:12px;margin-top:24px;text-align:center;">AI in Action</p>
  </div>
</body>
</html>
